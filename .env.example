# Copy to .env. start.ps1 loads it into the environment of the local services.
# .env is gitignored: never commit a real key.

# --- The demo attacker (backend/app/elevenlabs_agent.py) --------------------------------------
# Optional. Without a key the scripted caller falls back to a deterministic local DSP signal and
# says so in the dashboard; it never pretends to be text-to-speech.
#
# Only stock or prompt-designed voices are permitted. A voice cloned from a real person is
# refused in code, and a voice whose category cannot be checked is refused too
# (CLAUDE.md invariant 14, docs/CONSENT_LOG.md).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Live call ingest -------------------------------------------------------------------------
VOXGUARD_AUDIOSOCKET_HOST=127.0.0.1
VOXGUARD_AUDIOSOCKET_PORT=9019
VOXGUARD_GATEWAY_URL=http://127.0.0.1:8000
# The language asserted for a live Asterisk call that announces nothing else (docs/05 section 4).
VOXGUARD_LIVE_LANGUAGE=en

# --- Gateway --------------------------------------------------------------------------------
# Set this in any run whose audit records need to be attributable; the built-in fallback is a
# demo key and is labelled as one.
VOXGUARD_SIGNING_KEY=
